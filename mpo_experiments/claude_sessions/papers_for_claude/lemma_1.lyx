\begin_layout Standard
בהינתן 
\begin_inset Formula $A\in\R^{n\times n}$
\end_inset

 מטריצה סימטרית אי שלילית ו
\begin_inset Formula $S\in\R^{m\times n}$
\end_inset

 עבור 
\begin_inset Formula $m\le n$
\end_inset

 כך שלכל 
\begin_inset Formula $x\in range(A)$
\end_inset

 מתקיים כי 
\begin_inset Formula 
\[
(1-\varepsilon)\|x\|_{2}\le\|Sx\|_{2}\le(1+\varepsilon)\|x\|_{2}
\]

\end_inset

 אזי 
\begin_inset Formula 
\[
(1-\varepsilon)Tr(A)\le Tr(SAS^{T})\le(1+\varepsilon)Tr(A)
\]

\end_inset

 
\series bold
הוכחה
\end_layout

\begin_layout Standard
הואיל ו 
\begin_inset Formula $A$
\end_inset

 היא 
\begin_inset Formula $PSD$
\end_inset

 אזי מתקיים 
\begin_inset Formula 
\[
A=QDQ^{T}
\]

\end_inset

 עבור 
\begin_inset Formula $Q$
\end_inset

 שעמודותייה הן וקטורים עצמאיים של 
\begin_inset Formula $A$
\end_inset

 ו
\begin_inset Formula $D$
\end_inset

 אלכסונית עם 
\begin_inset Formula $D_{ii}=\lambda_{i}$
\end_inset

.
\end_layout

\begin_layout Standard
כמו כן באותם סימונים נקבל כי 
\begin_inset Formula 
\[
A=QD^{1/2}D^{1/2}Q^{T}
\]

\end_inset

 ואז עבור 
\begin_inset Formula $B=QD^{1/2}$
\end_inset

 נקבל כי 
\begin_inset Formula $A=B\cdot B^{T}$
\end_inset

.
\end_layout

\begin_layout Standard
כעת נזכור כי 
\begin_inset Formula 
\[
Tr(C\cdot C^{T})=\|C\|_{F}^{2}
\]

\end_inset

 אם כך נקבל כי 
\begin_inset Formula 
\[
Tr(SAS^{T})=Tr(SB\cdot B^{T}S^{T})=Tr(SB\cdot(SB)^{T})=\|SB\|_{F}^{2}
\]

\end_inset

ובאותה מידה
\begin_inset Formula 
\[
Tr(A)=\|B\|_{F}^{2}
\]

\end_inset

 אז רק נראה כי 
\begin_inset Formula 
\[
\|SB\|_{F}^{2}=\|B\|_{F}^{2}
\]

\end_inset

 בשביל לקבל את הדרוש.
 
\end_layout

\begin_layout Standard
נשים לב כי 
\begin_inset Formula $B=QD^{1/2}$
\end_inset

 כלומר אם נסמן את הוקטורים העצמאיים של 
\begin_inset Formula $A$
\end_inset

 עם 
\begin_inset Formula $v_{1},...,v_{n}$
\end_inset

 אז נקבל כי 
\begin_inset Formula 
\[
QD^{1/2}=\begin{bmatrix}| & | &  & |\\
\sqrt{\lambda_{1}}v_{1} & \sqrt{\lambda_{2}}v_{2} & ... & \sqrt{\lambda_{v}}v_{n}\\
| & | &  & |
\end{bmatrix}
\]

\end_inset


\end_layout

\begin_layout Standard
ואז 
\begin_inset Formula 
\[
SQD^{1/2}=\begin{bmatrix}| & | &  & |\\
S\sqrt{\lambda_{1}}v_{1} & S\sqrt{\lambda_{2}}v_{2} & ... & S\sqrt{\lambda_{v}}v_{n}\\
| & | &  & |
\end{bmatrix}
\]

\end_inset

 ולכן נקבל כי 
\begin_inset Formula 
\begin{align*}
\|SB\|_{F}^{2} & =\sum_{i,j}(SB)_{ij}^{2}\\
 & =\sum_{i=1}^{n}\|S\sqrt{\lambda_{i}}v_{i}\|_{2}^{2}\\
 & =\sum_{i=1}^{n}\lambda_{i}\|Sv_{i}\|_{2}^{2}\\
 & \le_{*}\sum_{i=1}^{n}\lambda_{i}(1+\varepsilon)^{2}\|v_{i}\|_{2}^{2}\\
 & =\sum_{i=1}^{n}(1+\varepsilon)^{2}\|\sqrt{\lambda}_{i}v_{i}\|_{2}^{2}\\
 & =(1+\varepsilon)^{2}\sum_{i=1}^{n}\|\sqrt{\lambda_{i}}v_{i}\|_{2}^{2}\\
 & =(1+\varepsilon)^{2}\cdot\|B\|_{F}^{2}
\end{align*}

\end_inset


\end_layout

